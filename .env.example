# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Private Family Communication System
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND VARIABLES (Public / Safe for browser bundle)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (public API key safe for frontend RLS access)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# VAPID Public Key for Web Push browser subscription (RFC 8292)
# Generated via `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjS5Snfyzj0n26n0UT_FYgoe35e-6W-h44fe4

# ------------------------------------------------------------------------------
# BACKEND / EDGE FUNCTIONS SECRETS (NEVER expose to frontend or git!)
# Configure in Supabase Dashboard -> Edge Functions -> Secrets
# ------------------------------------------------------------------------------
# Supabase Service Role Key (full database bypass, for trusted edge functions only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Web Push VAPID Private Key & Subject
VAPID_SUBJECT=mailto:admin@privateline.local
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjS5Snfyzj0n26n0UT_FYgoe35e-6W-h44fe4
VAPID_PRIVATE_KEY=your-vapid-private-key-base64url

# STUN / TURN WebRTC Infrastructure
# Comma-separated public STUN servers for NAT traversal discovery
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Server URLs (for symmetric NAT and restrictive cellular networks)
TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp

# Option A: Coturn Ephemeral Secret (recommended for self-hosted coturn)
# Shared static-auth-secret configured in turnserver.conf
TURN_STATIC_AUTH_SECRET=your-coturn-shared-secret-long-random-string

# Option B: Managed Static TURN Credentials (e.g., Metered.ca, Twilio, Xirsys)
# Leave blank if using Option A
TURN_USERNAME=
TURN_CREDENTIAL=

